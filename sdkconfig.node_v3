# Board (Heltec V3, 8MB flash)
CONFIG_BATEAR_BOARD_HELTEC_V3=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Role: LoRa node. Mic / rx / bridge default to auto and are set per device
# in NVS node_cfg (the web flasher writes them for the Detector / Gateway tabs).
CONFIG_BATEAR_ROLE_NODE=y
CONFIG_BATEAR_DEVICE_ID=1

# Network (must match on every LoRa node)
CONFIG_BATEAR_NET_KEY="DEADBEEFCAFEBABE13374200F00DAA55"
CONFIG_BATEAR_LORA_FREQ=915000
CONFIG_BATEAR_LORA_SYNC_WORD=0x12

# Telemetry heartbeat (jittered +-10% in firmware)
CONFIG_BATEAR_TELEMETRY_HEARTBEAT_MIN=30

# Partition table (3 MiB app for the combined LoRa node image)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_lora.csv"
